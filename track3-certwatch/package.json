{
  "name": "certwatch",
  "version": "1.0.0",
  "private": true,
  "description": "TLS certificate expiry monitor built on Telegraph (Track 3).",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts-build-dashboard.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "node dist/checkOnce.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:dashboard": "node scripts-build-dashboard.mjs"
  },
  "dependencies": {
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}