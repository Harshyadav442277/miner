{
  "name": "livecert-miner",
  "version": "1.0.0",
  "private": true,
  "description": "Live TLS certificate verification miner for Telegraph (SSL_VERIFICATION).",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test --test-skip-pattern=\"\\(live\\)\" dist-test/test/*.test.js",
    "test:live": "tsc -p tsconfig.test.json && node --test --test-name-pattern=\"\\(live\\)\" dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
